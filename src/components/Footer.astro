---
const socialLinks = [
  { href: 'https://github.com/degszz', label: 'GitHub', icon: 'github' },
  { href: 'https://www.linkedin.com/in/maximo-figuera-531231323/', label: 'LinkedIn', icon: 'linkedin' },
  { href: 'https://www.instagram.com/z3maxi/', label: 'Instagram', icon: 'instagram' },
]
---

<footer class="w-full border-t border-border" id="redes">
  <div class="flex justify-center py-8">
    <div class="max-w-[350px] md:max-w-[450px] lg:min-w-[750px] lg:max-w-[750px] w-full">
      <div class="flex items-center gap-2 mb-4">
        <span class="relative flex h-3 w-3">
          <span class="animate-pulse absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
        </span>
        <span class="text-sm text-muted-foreground">Disponible para proyectos</span>
      </div>

      <h4 class="text-2xl font-bold mb-2">Sigamos en Contacto</h4>
      <p class="text-muted-foreground mb-4">Para más información podés encontrarme en mis redes sociales.</p>

      <div class="flex gap-3">
        {socialLinks.map(link => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="h-10 w-10 rounded-full border border-border flex items-center justify-center text-muted-foreground hover:text-foreground hover:border-foreground hover:scale-110 transition-all duration-200"
            aria-label={link.label}
          >
            {link.icon === 'github' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/></svg>
            )}
            {link.icon === 'linkedin' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"/><path d="M8 11l0 5"/><path d="M8 8l0 .01"/><path d="M12 16l0 -5"/><path d="M16 16v-3a2 2 0 0 0 -4 0"/></svg>
            )}
            {link.icon === 'instagram' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z"/><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M16.5 7.5v.01"/></svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="h-[50px] w-full border-t border-border flex justify-center items-center">
    <p class="text-sm text-muted-foreground">© {new Date().getFullYear()} Maximo Figuera</p>
  </div>
</footer>
