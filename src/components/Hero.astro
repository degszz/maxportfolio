---
const name = 'Maximo'
const description = '+3 años de experiencia. Especializado en el desarrollo de aplicaciones web.'
const socialLinks = [
  {
    href: 'https://www.linkedin.com/in/maximo-figuera-531231323/',
    label: 'Linkedin',
    icon: 'linkedin',
  },
  {
    href: 'https://github.com/degszz',
    label: 'Github',
    icon: 'github',
  },
  {
    href: 'https://www.instagram.com/z3maxi/',
    label: 'Instagram',
    icon: 'instagram',
  },
]
---

<section id="inicio" class=" relative min-h-[60vh] flex flex-col justify-center pt-[51px] lg:pt-[60px]">
  <div class="flex justify-center h-full">
    <div
      class="max-w-[350px] md:max-w-[450px] lg:min-w-[750px] lg:max-w-[750px] pt-6 md:py-4 flex flex-col justify-center items-center z-10"
    >
      <div class="flex justify-start w-full">
        <img
          src="/yo.png"
          width="70"
          height="70"
          class="w-[70px] h-[70px] rounded-full shadow-xl"
          alt="Maximo Figuera"
          loading="lazy"
        />
      </div>
      <div class="h-fit w-full mx-4 text-start flex-col">
        <div class="my-2.5">
          <h1 class="text-3xl underline">
            <b>Hey! soy {name}</b>
          </h1>
          <p class="text-xl max-w-[280px] sm:max-w-[350px] md:max-w-[450px] lg:max-w-[500px]">
            {description}
          </p>
          <p class="mt-1">
            <b class="text-kai-button transition-all duration-300" id="hero-role">Developer UX/UI</b>
          </p>
        </div>
        <div class="flex flex-wrap gap-1 z-50">
          {socialLinks.map(link => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex text-sm mr-1 mb-2 px-4 py-2 z-50 text-black font-medium text-center justify-center items-center flex-row rounded-lg border gap-x-2 opacity-90 cursor-pointer bg-white hover:text-black hover:scale-110 hover:shadow-lg hover:opacity-100 focus:ring-2 focus:outline-none focus:ring-black/30 transition-all duration-200 ease-in-out scale-90"
            >
              {link.icon === 'linkedin' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"/><path d="M8 11l0 5"/><path d="M8 8l0 .01"/><path d="M12 16l0 -5"/><path d="M16 16v-3a2 2 0 0 0 -4 0"/></svg>
              )}
              {link.icon === 'github' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/></svg>
              )}
              {link.icon === 'instagram' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z"/><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M16.5 7.5v.01"/></svg>
              )}
              <span class="hidden md:block">{link.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div id="scroll-indicator" class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce text-muted-foreground text-2xl">
    ↓
  </div>
</section>

<style>
  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .hero-bg {
    background: linear-gradient(135deg, #0c1929, #000000, #091428);
    background-size: 200% 200%;
    animation: gradient-shift 8s ease infinite;
  }
</style>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const roles = ['Developer UX/UI', 'LLM Engineer', 'Fullstack Developer', 'React Builder']
    let index = 0
    const el = document.getElementById('hero-role')
    if (el) {
      setInterval(() => {
        index = (index + 1) % roles.length
        el.classList.add('opacity-0', 'translate-y-2')
        setTimeout(() => {
          el.textContent = roles[index]
          el.classList.remove('opacity-0', 'translate-y-2')
        }, 300)
      }, 2500)
    }
  }

  window.addEventListener('scroll', () => {
    document.getElementById('scroll-indicator')?.remove()
  }, { once: true })
</script>
