---
import { projects } from '../data/projects'
import type { ProjectCategory } from '../data/projects'

const categories: ('All' | ProjectCategory)[] = ['All', 'AI/LLM', 'Frontend', 'Backend', 'Fullstack']

const BADGE_COLOR: Record<ProjectCategory, string> = {
  'AI/LLM': 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  'Frontend': 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  'Backend': 'bg-green-500/10 text-green-400 border-green-500/20',
  'Fullstack': 'bg-amber-500/10 text-amber-400 border-amber-500/20',
}
---

<section id="proyectos" class="py-12 opacity-0 translate-y-6 transition-all duration-500" data-reveal>
  <div class="flex justify-center">
    <div class="max-w-[350px] md:max-w-[450px] lg:min-w-[750px] lg:max-w-[750px] w-full">
      <h2 class="text-2xl font-bold mb-6">🚀 Proyectos</h2>

      <!-- Filter tabs -->
      <div class="flex flex-wrap gap-2 mb-6">
        {categories.map((cat, i) => (
          <button
            data-filter={cat === 'All' ? 'all' : cat}
            class:list={[
              'px-4 py-1.5 rounded-full text-sm border transition-colors',
              i === 0 ? 'bg-primary text-primary-foreground border-primary' : 'border-border text-muted-foreground hover:text-foreground',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Project grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 hover:cursor-pointer">
        {projects.map(project => (
          <div
            data-category={project.category}
            data-tilt
            class="relative rounded-xl border border-border bg-card overflow-hidden hover:-translate-y-1 hover:shadow-lg transition-all duration-200"
            style="transition: transform 0.3s ease"
          >
            {project.placeholder && (
              <div class="absolute inset-0 rounded-xl backdrop-blur-sm bg-background/70 flex items-center justify-center z-10">
                <span class="px-3 py-1 rounded-full border border-border text-sm text-muted-foreground">Próximamente</span>
              </div>
            )}

            {project.image && (
              <div class="h-32 overflow-hidden bg-gradient-to-br from-muted to-card flex items-center justify-center">
                <img src={project.image} alt={project.title} class="w-20 h-20 object-contain" loading="lazy" />
              </div>
            )}

            <div class="p-4">
              <span class:list={['inline-block px-2 py-0.5 rounded-full text-xs border mb-2', BADGE_COLOR[project.category]]}>
                {project.category}
              </span>
              <h3 class="font-semibold text-foreground">{project.title}</h3>
              <p class="text-sm text-muted-foreground mt-1">{project.tagline}</p>

              <div class="flex flex-wrap gap-1 mt-3">
                {project.stack.slice(0, 3).map(tech => (
                  <span class="px-2 py-0.5 rounded-full bg-muted text-muted-foreground text-xs">{tech}</span>
                ))}
                {project.stack.length > 3 && (
                  <span class="px-2 py-0.5 rounded-full bg-muted text-muted-foreground text-xs">+{project.stack.length - 3}</span>
                )}
              </div>

              <div class="flex gap-2 mt-4">
                <button
                  onclick={`document.getElementById('modal-${project.id}').showModal()`}
                  class="text-xs text-primary hover:underline"
                >
                  Ver detalles
                </button>
                {project.liveUrl && (
                  <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-muted-foreground hover:text-foreground">
                    Live ↗
                  </a>
                )}
              </div>
            </div>

            <!-- Modal -->
            <dialog id={`modal-${project.id}`} class="rounded-xl border border-border bg-card text-foreground p-6 backdrop:bg-black/60 max-w-lg w-full">
              <form method="dialog">
                <button class="absolute top-4 right-4 text-muted-foreground hover:text-foreground text-xl">✕</button>
              </form>
              <h3 class="text-xl font-bold mb-2">{project.title}</h3>
              <p class="text-sm text-muted-foreground mb-4">{project.tagline}</p>
              <h4 class="text-sm font-medium mb-1">Challenge:</h4>
              <p class="text-sm text-muted-foreground mb-4">{project.challenge}</p>
              <h4 class="text-sm font-medium mb-1">Stack:</h4>
              <div class="flex flex-wrap gap-1">
                {project.stack.map(tech => (
                  <span class="px-2 py-0.5 rounded-full bg-muted text-muted-foreground text-xs">{tech}</span>
                ))}
              </div>
              {(project.liveUrl || project.repoUrl) && (
                <div class="flex gap-3 mt-4 pt-4 border-t border-border">
                  {project.liveUrl && <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-primary hover:underline">Ver en vivo ↗</a>}
                  {project.repoUrl && <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-primary hover:underline">Repositorio ↗</a>}
                </div>
              )}
            </dialog>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Filter tabs
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-filter]')
  const cards = document.querySelectorAll<HTMLElement>('[data-category]')

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter!
      tabs.forEach(t => {
        t.classList.remove('bg-primary', 'text-primary-foreground', 'border-primary')
        t.classList.add('border-border', 'text-muted-foreground')
      })
      tab.classList.add('bg-primary', 'text-primary-foreground', 'border-primary')
      tab.classList.remove('border-border', 'text-muted-foreground')
      cards.forEach(card => {
        const show = filter === 'all' || card.dataset.category === filter
        card.classList.toggle('hidden', !show)
      })
    })
  })

  // 3D tilt - desktop only
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && window.innerWidth >= 768) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const { left, top, width, height } = card.getBoundingClientRect()
        const rx = ((e.clientY - top) / height - 0.5) * -12
        const ry = ((e.clientX - left) / width - 0.5) * 12
        card.style.transform = `perspective(800px) rotateX(${rx}deg) rotateY(${ry}deg)`
      })
      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg)'
      })
    })
  }
</script>
