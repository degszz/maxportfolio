---
import { certificates } from '../data/certificates'
import type { CertCategory } from '../data/certificates'

const CATEGORY_GLOW: Record<CertCategory, string> = {
  AI: 'hover:border-purple-500/50 hover:shadow-purple-500/10',
  Cloud: 'hover:border-blue-500/50 hover:shadow-blue-500/10',
  WebDev: 'hover:border-green-500/50 hover:shadow-green-500/10',
  Other: 'hover:border-border hover:shadow-muted/10',
}

const filterCategories: ('All' | CertCategory)[] = ['All', 'AI', 'WebDev', 'Cloud', 'Other']
---

<section id="certificados" class="py-12 transition-all duration-500" data-reveal>
  <div class="flex justify-center">
    <div class="max-w-[350px] md:max-w-[450px] lg:min-w-[750px] lg:max-w-[750px] w-full">
      <h2 class="text-2xl font-bold mb-6">🏆 Certificados</h2>

      <!-- Filter tabs -->
      <div class="flex flex-wrap gap-2 mb-6">
        {filterCategories.map((cat, i) => (
          <button
            data-cert-filter={cat === 'All' ? 'all' : cat}
            class:list={[
              'px-4 py-1.5 rounded-full text-sm border transition-colors',
              i === 0 ? 'bg-primary text-primary-foreground border-primary' : 'border-border text-muted-foreground hover:text-foreground',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Certificates grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 hover:cursor-pointer">
        {certificates.map(cert => (
          <article
            data-cert-category={cert.category}
            class:list={[
              'rounded-xl border border-border p-4 bg-card hover:-translate-y-1 hover:shadow-lg transition-all duration-200',
              CATEGORY_GLOW[cert.category],
            ]}
          >
            {cert.image ? (
              <div class="h-16 w-full flex items-center justify-center mb-3">
                <img src={cert.image} alt={cert.name} class="h-12 object-contain" loading="lazy" />
              </div>
            ) : (
              <div class="h-16 w-full flex items-center justify-center rounded-md bg-muted text-2xl font-bold text-muted-foreground mb-3">
                {cert.issuer.slice(0, 2).toUpperCase()}
              </div>
            )}
            <h3 class="font-semibold text-sm text-foreground leading-snug">{cert.name}</h3>
            <p class="text-xs text-muted-foreground mt-1">{cert.issuer} · {cert.date}</p>
            <span class="inline-block mt-2 px-2 py-0.5 rounded-full bg-muted text-xs text-muted-foreground">{cert.category}</span>
            {cert.verifyUrl && (
              <a href={cert.verifyUrl} target="_blank" rel="noopener noreferrer" class="block mt-3 text-xs text-primary hover:underline">
                Verificar ↗
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const certTabs = document.querySelectorAll<HTMLButtonElement>('[data-cert-filter]')
  const certCards = document.querySelectorAll<HTMLElement>('[data-cert-category]')

  certTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.certFilter!
      certTabs.forEach(t => {
        t.classList.remove('bg-primary', 'text-primary-foreground', 'border-primary')
        t.classList.add('border-border', 'text-muted-foreground')
      })
      tab.classList.add('bg-primary', 'text-primary-foreground', 'border-primary')
      tab.classList.remove('border-border', 'text-muted-foreground')
      certCards.forEach(card => {
        const show = filter === 'all' || card.dataset.certCategory === filter
        card.classList.toggle('hidden', !show)
      })
    })
  })
</script>
